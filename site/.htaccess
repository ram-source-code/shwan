Options -Indexes
DirectoryIndex index.php
# Files refused by the Require rules below never reach PHP; this keeps their 403 short and on-brand.
ErrorDocument 403 "<!doctype html><html lang=en><meta charset=utf-8><meta name=viewport content='width=device-width'><title>Access denied | Entersoftgroup</title><body><h1>Access denied</h1><p>This address is not open to visitors. Entersoftgroup &middot; 0770 155 8796</p></body></html>"
RewriteEngine On
RewriteRule ^\.well-known/ - [L]
# one 301 hop to the canonical https://www.entersoftgroup.com. The first line skips it on a dev machine,
# whose own address is loopback or private (localhost, phone tests over the LAN).
RewriteCond %{SERVER_ADDR} !^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|::1$)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.entersoftgroup\.com$ [NC]
RewriteRule ^ https://www.entersoftgroup.com%{REQUEST_URI} [L,R=301]
# blocked paths answer a styled 403 from index.php (FORBIDDEN flag); the FilesMatch rules below are the backstop
RewriteRule (^|/)\. index.php [L,E=FORBIDDEN:1]
RewriteRule ^(data|includes)(/|$) index.php [L,E=FORBIDDEN:1]
RewriteRule \.(sqlite|sqlite3|db|log|json|md|env|example|bak|zip|flag|ini|sh)$ index.php [L,NC,E=FORBIDDEN:1]
# one entry point: no PHP file but index.php runs, not even with a trailing /path
RewriteCond %{REQUEST_URI} \.(php\d?|phtml|phar)(/|$) [NC]
RewriteRule !^index\.php$ index.php [L,E=FORBIDDEN:1]
# everything that isn't an existing file -> index.php. No RewriteBase: the folder works at any depth
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
<FilesMatch "\.(sqlite|sqlite3|db|log|json|md|env|example|bak|zip|flag|ini|sh)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
AddType application/manifest+json .webmanifest
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=(), unload=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  <FilesMatch "^(robots\.txt|sitemap\.xml|favicon\.ico|icon\.svg|apple-touch-icon\.png|og-default\.jpg)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(favicon\.ico|icon\.svg|apple-touch-icon\.png|og-default\.jpg)$">
    Header always set Cross-Origin-Resource-Policy "cross-origin"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml application/xml application/manifest+json
</IfModule>
